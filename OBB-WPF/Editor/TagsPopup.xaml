<Window x:Class="OBB_WPF.Editor.TagsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OBB_WPF.Editor"
        mc:Ignorable="d"
        Title="TagsPopup" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Tag1" Grid.Row="0">Source</TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue1" Grid.Row="0"></TextBox>
        <TextBox x:Name="Tag2" Grid.Row="1">Year</TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue2" Grid.Row="1"></TextBox>
        <TextBox x:Name="Tag3" Grid.Row="2">Season</TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue3" Grid.Row="2"></TextBox>
        <TextBox x:Name="Tag4" Grid.Row="3"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue4" Grid.Row="3"></TextBox>
        <TextBox x:Name="Tag5" Grid.Row="4"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue5" Grid.Row="4"></TextBox>
        <TextBox x:Name="Tag6" Grid.Row="5"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue6" Grid.Row="5"></TextBox>
        <TextBox x:Name="Tag7" Grid.Row="6"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue7" Grid.Row="6"></TextBox>
        <TextBox x:Name="Tag8" Grid.Row="7"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue8" Grid.Row="7"></TextBox>
        <TextBox x:Name="Tag9" Grid.Row="8"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue9" Grid.Row="8"></TextBox>
        <TextBox x:Name="Tag10" Grid.Row="9"></TextBox>
        <TextBox Grid.Column="1" x:Name="TagValue10" Grid.Row="9"></TextBox>

        <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" Grid.Row="10"></Button>
        <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" Grid.Row="10" Grid.Column="1"></Button>
    </Grid>
</Window>
